@page
@model Lab_4.Pages.Tickets.IndexModel
@{
    ViewData["Title"] = "Razor Pages: Квитки";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Лабораторна робота №4: Razor Pages + Web API</h2>
    <div>
        <a asp-page="./Create" class="btn btn-primary me-2">+ Забронювати квиток</a>
        <a href="/api/TicketsApi" target="_blank" class="btn btn-outline-info">Відкрити Web API (JSON)</a>
    </div>
</div>

<table class="table table-bordered table-striped align-middle">
    <thead class="table-dark">
        <tr>
            <th>№</th>
            <th>Пасажир</th>
            <th>Поїзд / Маршрут</th>
            <th>Вагон</th>
            <th>Дата / Час</th>
            <th>Разом</th>
            <th class="text-center">Дії</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Tickets)
    {
        <tr>
            <td><strong>@item.Id</strong></td>
            <td>@item.Passenger?.FullName<br /><small class="text-muted">@item.Passenger?.Phone</small></td>
            <td>№@item.Train?.TrainNumber (@item.Train?.TrainType)<br /><span class="badge bg-secondary">до @item.Train?.Destination?.Name</span></td>
            <td>№@item.CarriageNumber (@item.CarriageType?.TypeName)</td>
            <td>@item.DepartureDate<br /><small>@item.Train?.DepartureTime — @item.Train?.ArrivalTime</small></td>
            <td><strong>@item.TotalCost.ToString("F2") грн</strong></td>
            <td class="text-center">
                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Редагувати</a>
                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Видалити</a>
            </td>
        </tr>
    }
    </tbody>
</table>