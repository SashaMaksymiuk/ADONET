@model Lab_3.Models.Ticket

@{
    ViewData["Title"] = "Нове бронювання";
}

<h2>Оформити бронювання квитка</h2>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div class="mb-3">
                <label asp-for="PassengerId" class="form-label"></label>
                <select asp-for="PassengerId" class="form-select" asp-items="ViewBag.PassengerId"></select>
            </div>
            <div class="mb-3">
                <label asp-for="TrainId" class="form-label"></label>
                <select asp-for="TrainId" class="form-select" asp-items="ViewBag.TrainId"></select>
            </div>
            <div class="mb-3">
                <label asp-for="CarriageNumber" class="form-label"></label>
                <input asp-for="CarriageNumber" class="form-control" type="number" min="1" value="1" />
            </div>
            <div class="mb-3">
                <label asp-for="CarriageTypeId" class="form-label"></label>
                <select asp-for="CarriageTypeId" class="form-select" asp-items="ViewBag.CarriageTypeId"></select>
            </div>
            <div class="mb-3">
                <label asp-for="DepartureDate" class="form-label"></label>
                <input asp-for="DepartureDate" class="form-control" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>
            <div class="mb-3">
                <label asp-for="UrgencySurcharge" class="form-label"></label>
                <input asp-for="UrgencySurcharge" class="form-control" type="number" step="0.01" value="0.00" />
            </div>
            <button type="submit" class="btn btn-success">Зберегти</button>
            <a asp-action="Index" class="btn btn-secondary">Назад до списку</a>
        </form>
    </div>
</div>