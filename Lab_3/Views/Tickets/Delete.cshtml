@model Lab_3.Models.Ticket

@{
    ViewData["Title"] = "Видалення квитка";
}

<h2>Підтвердження видалення</h2>
<h4 class="text-danger">Ви впевнені, що хочете видалити цей квиток?</h4>
<hr />
<div>
    <dl class="row">
        <dt class="col-sm-3">Пасажир</dt>
        <dd class="col-sm-9">@Model.Passenger?.FullName</dd>

        <dt class="col-sm-3">Поїзд</dt>
        <dd class="col-sm-9">№@Model.Train?.TrainNumber (@Model.Train?.Destination?.Name)</dd>

        <dt class="col-sm-3">Дата поїздки</dt>
        <dd class="col-sm-9">@Model.DepartureDate</dd>

        <dt class="col-sm-3">Загальна вартість</dt>
        <dd class="col-sm-9"><strong>@Model.TotalCost.ToString("F2") грн</strong></dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Підтвердити видалення</button>
        <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
    </form>
</div>